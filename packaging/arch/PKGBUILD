# Maintainer: openOODA-tools <ops@openooda.org>
pkgname=oosensors-bin
_pkgname=oosensors
pkgver=0.1.0
pkgrel=1
pkgdesc="Reads hardware thermal sensors, fan RPM, voltage rails, and throttling alerts."
arch=('x86_64')
url="https://github.com/openOODA-tools/oosensors"
license=('Apache-2.0')
depends=('glibc')
provides=('oosensors')
conflicts=('oosensors')
source_x86_64=("${url}/releases/download/v${pkgver}/oosensors-linux-x86_64"
               "uninstall.sh::https://raw.githubusercontent.com/openOODA-tools/${_pkgname}/v${pkgver}/uninstall.sh")
sha256sums_x86_64=('SKIP'
                   'SKIP')

package() {
    install -Dm755 "${srcdir}/oosensors-linux-x86_64" "${pkgdir}/usr/bin/oosensors"
    install -Dm755 uninstall.sh "${pkgdir}/usr/bin/oosensors-uninstall"
}
